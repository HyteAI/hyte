# Browser-visible: a publishable key is designed for public clients. RLS protects records.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only; configure in Vercel. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HYTE_OWNER_ID=

# Optional image reading. A paid API account/key is required; never put it in client code.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional background Web Push. Generate keys once and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-real-email@example.com
CRON_SECRET=
# Set true only after registering and verifying the authenticated minute trigger.
HYTE_SCHEDULER_ENABLED=false
